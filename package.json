{
  "name": "omega-factory",
  "version": "0.1.0",
  "private": true,
  "description": "An Itioverse factory-building game about systems, flow, and possibility.",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Itio",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && electron-builder --dir",
    "dist:desktop": "npm run build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "io.itio.omegafactory",
    "productName": "Omega Factory",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.simulation-games"
    },
    "icon": "public/icon.png"
  },
  "dependencies": {
    "@lucide/svelte": "^1.52.0",
    "@threlte/core": "^8.6.1",
    "svelte": "^5.57.2",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11"
  },
  "desktopName": "io.itio.omegafactory.desktop"
}
