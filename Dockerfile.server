# Wish API server (`node server/main.mjs`). Build from committed source:
#   git archive HEAD | docker build -f Dockerfile.server -t omega-factory-wish:<sha> -
FROM node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# Lockfile-verified install; the server imports only js-yaml (+argparse) and zod.
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:24-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
# git: brain commits/pushes; python3 + PyYAML: Kido scripts; flock (util-linux,
# in the base image): storage locks; tini reaps the guarded git/python children.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    git python3 python3-yaml ca-certificates openssh-client tini \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY --from=deps /app/node_modules/js-yaml node_modules/js-yaml
COPY --from=deps /app/node_modules/argparse node_modules/argparse
COPY --from=deps /app/node_modules/zod node_modules/zod
COPY server/ server/
RUN rm server/*.test.mjs \
  && node --input-type=module -e "for (const m of ['http','store','kido','lock','worker','claude']) await import('/app/server/' + m + '.mjs')" \
  && command -v flock git python3 \
  && python3 -c 'import yaml' \
  && mkdir -p /data/wishes /data/brains \
  && chown -R node:node /data
ENV NODE_ENV=production \
  WISH_HOST=0.0.0.0 \
  WISH_PORT=8787 \
  WISH_PROJECT_ROOT=/app \
  WISH_STORE=/data/wishes/wishes.yaml \
  WISH_BRAINS=/data/brains \
  WISH_KIDO_ROOT=/opt/kido
USER node
EXPOSE 8787
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "server/main.mjs"]
